{
  "name": "react-native-starter",
  "version": "4.2.3",
  "private": false,
  "scripts": {
    "start": "react-native start",
    "test": "node --test tests/*.test.cjs && jest --runInBand",
    "test:update": "jest -u",
    "test:coverage": "jest --coverage",
    "run:ios": "react-native run-ios",
    "run:android": "react-native run-android",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output .build/android/index.android.bundle --assets-dest .build/android/assets --max-workers 2",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output .build/ios/main.jsbundle --assets-dest .build/ios/assets --max-workers 2",
    "postinstall": "node scripts/patch-deepmerge.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/checkbox": "^0.6.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/drawer": "^7.14.4",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/stack": "^7.12.1",
    "i18n-js": "^4.5.4",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "^3.4.0",
    "react-native-get-random-values": "^2.1.0",
    "react-native-gifted-chat": "^3.4.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-localize": "^3.7.2",
    "react-native-maps": "^1.29.11",
    "react-native-modal": "13.0.1",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-nav": "^2.0.2",
    "react-native-paper": "^5.15.4",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "^15.16.1",
    "react-native-svg-charts": "^5.4.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-walkthrough-tooltip": "^1.7.0",
    "react-native-webview": "^14.0.1",
    "react-redux": "^9.3.1",
    "redux": "^5.0.1",
    "redux-logger": "^3.0.6",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.1.0",
    "victory-native": "36.9.2",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@react-native-community/datetimepicker": "^9.3.0",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "react-native-reanimated-carousel": "^5.2.1",
    "react-native-select-dropdown": "^4.0.1",
    "react-native-worklets": "0.13.1",
    "react-native-keyboard-controller": "^1.22.9",
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/eslint-parser": "^7.29.13",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-flow": "^7.29.7",
    "@babel/runtime": "^7.29.13",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/react": "^19.2.0",
    "babel-jest": "30.5.2",
    "danger": "^14.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "jest": "30.5.2",
    "plop": "^4.0.5",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.3",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^30.0.0",
    "globals": "^17.13.0",
    "@eslint/js": "^9.39.5"
  },
  "engines": {
    "node": ">=22.23.0"
  },
  "overrides": {
    "react-native-svg-charts": {
      "react-native-svg": "$react-native-svg",
      "d3-array": "^3.2.4",
      "d3-scale": "^4.0.2",
      "d3-shape": "^3.2.0",
      "d3-interpolate-path": "^2.3.0"
    },
    "@jest/reporters": {
      "glob": "^14.0.3"
    },
    "jest-config": {
      "glob": "^14.0.3"
    },
    "jest-runtime": {
      "glob": "^14.0.3"
    },
    "test-exclude@>=7": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.1"
    }
  }
}
